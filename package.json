{
  "name": "dsh-mathmodel-desktop",
  "version": "0.1.9",
  "private": true,
  "description": "DeepSeek 数学建模版：通用编程 Harness 桌面端，内置独立 Node 运行时、dsh 宿主（0.2.1-rc.4）与预装插件。",
  "main": "src/main.cjs",
  "author": "DeepSeek Harness Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "fetch-node": "node scripts/fetch-node.mjs",
    "fetch-pnpm": "node scripts/fetch-pnpm.mjs",
    "build-runtime": "node scripts/build-runtime.mjs",
    "prepare-runtime": "node scripts/fetch-node.mjs && node scripts/fetch-pnpm.mjs && node scripts/build-runtime.mjs",
    "prepack": "node scripts/build-runtime.mjs --local-only",
    "pack": "electron-builder --dir",
    "predist": "node scripts/build-runtime.mjs --local-only",
    "dist": "electron-builder --mac --win",
    "predist:mac": "node scripts/build-runtime.mjs --local-only",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "predist:win": "node scripts/build-runtime.mjs --local-only",
    "dist:win": "electron-builder --win nsis zip --x64",
    "verify:win": "node scripts/verify-windows-package.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  }
}
