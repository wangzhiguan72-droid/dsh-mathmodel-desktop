{
  "name": "dsh-mathmodel-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "DeepSeek 数学建模版：通用编程 Harness 桌面端，内置独立 Node 运行时、dsh 宿主（0.2.0-rc.2）与预装插件。",
  "main": "src/main.cjs",
  "author": "DeepSeek Harness Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "fetch-node": "node scripts/fetch-node.mjs",
    "fetch-pnpm": "node scripts/fetch-pnpm.mjs",
    "build-runtime": "node scripts/build-runtime.mjs",
    "prepare-runtime": "node scripts/fetch-node.mjs && node scripts/fetch-pnpm.mjs && node scripts/build-runtime.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "dist:win": "electron-builder --win nsis zip --x64",
    "verify:win": "node scripts/verify-windows-package.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  }
}
